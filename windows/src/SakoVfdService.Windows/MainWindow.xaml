<ui:FluentWindow x:Class="SakoVfdService.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SAKO VFD Service — LAN Device Discovery" Height="820" Width="1290"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Background="#F5F7FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="78"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#DEE5EC" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SAKO VFD SERVICE" FontSize="20" FontWeight="SemiBold" Foreground="#1C3655"/>
          <TextBlock Text="Portable SKI780 diagnostics  •  Waveshare ESP32-S3-RS485-CAN" Foreground="#637689" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#EBF3FE" CornerRadius="12" Padding="11,6" Margin="0,0,8,0">
            <TextBlock x:Name="EspState" Text="ESP32: Not connected" Foreground="#285E9E" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#F0F2F4" CornerRadius="12" Padding="11,6">
            <TextBlock x:Name="VfdState" Text="VFD: Unknown" Foreground="#526273" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="15">
      <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#DFE6ED" BorderThickness="1" Padding="16">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Find Service Tool" FontSize="18" FontWeight="SemiBold" Foreground="#1C3655"/>
            <TextBlock Text="Scan this PC's local IPv4 networks for Waveshare devices." TextWrapping="Wrap" Foreground="#708093" Margin="0,5,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
              <Button x:Name="ScanButton" Content="Scan LAN" Width="116" Height="36" Click="Scan_Click"/>
              <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="36" Margin="9,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="ScanStatus" Foreground="#637689" Text="Ready to scan" Margin="0,6,0,10" TextWrapping="Wrap"/>
            <ProgressBar x:Name="ScanProgress" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,15"/>
            <TextBlock Text="Discovered devices" FontWeight="SemiBold" Margin="0,0,0,6"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Separator Margin="0,0,0,12"/>
            <TextBlock Text="Manual connection" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ManualIp" Height="35" VerticalContentAlignment="Center" ToolTip="IPv4 address, e.g. 192.168.1.120" Margin="0,0,0,8"/>
            <Button Content="Connect to IP" Height="36" Click="ManualConnect_Click"/>
            <TextBlock Text="Only devices verified by /api/status are accepted. No password or IP is sent to any cloud service." TextWrapping="Wrap" Foreground="#7B8895" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
          <ListBox x:Name="DeviceList" BorderThickness="0" SelectionChanged="DeviceList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#F3F7FC" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="9" Margin="0,4" Padding="10">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#233E5B" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" Foreground="#5A6F86" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#DFE6ED" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FBFCFF" BorderBrush="#E3EAF0" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="AddressText" Text="No device connected" Foreground="#49627D" VerticalAlignment="Center" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Content="Refresh" Width="82" Margin="0,0,8,0" Click="Refresh_Click"/>
              <Button Grid.Column="2" Content="Open in Browser" Width="130" Click="OpenBrowser_Click"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="DeviceBrowser" Visibility="Collapsed"/>
            <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
              <TextBlock Text="Select a Waveshare device" FontSize="23" FontWeight="SemiBold" Foreground="#2C4560" TextAlignment="Center"/>
              <TextBlock Text="Click Scan LAN, choose a device, or enter its local IPv4 address. The existing ESP32 dashboard will open here." Foreground="#718398" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
              <TextBlock Text="Dashboard  •  Parameters  •  Library  •  JSON Backup" Foreground="#3780BE" TextAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#EAF0F6" Padding="16,7">
      <TextBlock Text="Local-only connection  ·  ESP32/VFD status shown separately  ·  Windows desktop preview v0.1" Foreground="#576D80" FontSize="11"/>
    </Border>
  </Grid>
</ui:FluentWindow>
