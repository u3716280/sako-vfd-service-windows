<ui:FluentWindow x:Class="SakoVfdService.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="SAKO VFD Service" Height="860" Width="1360" MinHeight="680" MinWidth="1060" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
 <ui:FluentWindow.Resources>
  <SolidColorBrush x:Key="AppBackground" Color="#F4F7FA"/><SolidColorBrush x:Key="PanelBackground" Color="White"/><SolidColorBrush x:Key="PanelBorder" Color="#DDE5ED"/><SolidColorBrush x:Key="PrimaryText" Color="#1C3655"/><SolidColorBrush x:Key="SecondaryText" Color="#637689"/><SolidColorBrush x:Key="SoftBackground" Color="#EEF4FA"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/></Style>
 </ui:FluentWindow.Resources>
 <Grid Background="{DynamicResource AppBackground}">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="20,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="SAKO VFD SERVICE" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Native Windows service console for SKI780" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource SoftBackground}" CornerRadius="12" Padding="11,6" Margin="0,0,7,0"><TextBlock x:Name="EspState" Text="ESP32: Not connected"/></Border><Border Background="{DynamicResource SoftBackground}" CornerRadius="12" Padding="11,6" Margin="0,0,12,0"><TextBlock x:Name="VfdState" Text="VFD: Unknown"/></Border><ComboBox x:Name="LanguageBox" Width="104" Height="34" SelectionChanged="Language_Changed"><ComboBoxItem Tag="th">ไทย</ComboBoxItem><ComboBoxItem Tag="en">English</ComboBoxItem></ComboBox><Button x:Name="ThemeButton" Content="Dark" Width="74" Height="34" Margin="8,0,0,0" Click="Theme_Click"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="15">
    <DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="DiscoverTitle" Text="ค้นหาอุปกรณ์" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DiscoverHelp" Text="กดค้นหา แล้วเลือกอุปกรณ์ที่ต้องการเชื่อมต่อ" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,13"/><StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="ค้นหาใน LAN" Width="122" Height="36" Click="Scan_Click"/><Button x:Name="CancelButton" Content="ยกเลิก" Width="88" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/></StackPanel><TextBlock x:Name="ScanStatus" Text="พร้อมค้นหา" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,7"/><ProgressBar x:Name="ScanProgress" Height="4" Minimum="0" Maximum="100" Margin="0,0,0,12"/><TextBlock x:Name="FoundTitle" Text="อุปกรณ์ที่พบ" FontWeight="SemiBold" Margin="0,0,0,5"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Separator Margin="0,0,0,10"/><TextBlock x:Name="ManualTitle" Text="เชื่อมต่อด้วย IP" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="ManualIp" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,7"/><Button x:Name="ManualButton" Content="ตรวจสอบ IP" Height="36" Click="ManualConnect_Click"/><TextBlock x:Name="PrivacyText" Text="เชื่อมต่อภายใน LAN เท่านั้น ไม่มีการส่งข้อมูลขึ้น Cloud" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
     <ListBox x:Name="DeviceList" BorderThickness="0" SelectionChanged="DeviceList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SoftBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Margin="0,3" Padding="9"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <TabControl x:Name="MainTabs" Background="{DynamicResource PanelBackground}">
     <TabItem x:Name="DashboardTab" Header="Dashboard"><Grid><Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource SoftBackground}" Padding="14,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AddressText" Text="ยังไม่ได้เชื่อมต่อ" VerticalAlignment="Center" FontWeight="SemiBold"/><Button x:Name="RefreshButton" Grid.Column="1" Content="รีเฟรช" Width="82" Margin="0,0,7,0" Click="Refresh_Click"/><Button x:Name="BrowserButton" Grid.Column="2" Content="เปิดใน Browser" Width="126" Click="OpenBrowser_Click"/></Grid></Border><Grid Grid.Row="1"><wv2:WebView2 x:Name="DeviceBrowser" Visibility="Collapsed"/><StackPanel x:Name="EmptyView" Width="430" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="รอเลือก SAKO Service Tool" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyHelp" Text="กดค้นหา จากนั้นเลือกอุปกรณ์ที่ต้องการติดต่อ โปรแกรมจะไม่เชื่อมต่ออัตโนมัติ" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Grid></Grid></TabItem>
     <TabItem x:Name="BackupTab" Header="Backup / Compare / Restore"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock x:Name="BackupTitle" Text="สำรองข้อมูล VFD" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="BackupHelp" Text="อ่านค่า RO/RW จาก VFD และบันทึกเป็น JSON ลงในคอมพิวเตอร์" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="BackupStartButton" Content="เริ่ม Backup" Width="112" Height="36" Click="BackupStart_Click"/><Button x:Name="BackupCancelButton" Content="ยกเลิก" Width="86" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="BackupCancel_Click"/><Button x:Name="BackupDownloadButton" Content="บันทึก JSON..." Width="126" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="BackupDownload_Click"/></StackPanel><ProgressBar x:Name="BackupProgress" Height="8" Margin="0,12,0,5"/><TextBlock x:Name="BackupStatusText" Text="ยังไม่ได้เริ่ม" Foreground="{DynamicResource SecondaryText}"/>
      <Separator Margin="0,18,0,14"/><TextBlock x:Name="CompareTitle" Text="เปรียบเทียบ Backup" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CompareHelp" Text="เลือกไฟล์ JSON สองไฟล์ เพื่อแสดงเฉพาะค่าที่ต่างกัน" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="CompareButton" Content="เลือก 2 ไฟล์..." Width="120" Height="35" Click="Compare_Click"/><TextBlock x:Name="CompareSummary" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><DataGrid x:Name="CompareGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="245" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Parameter" Binding="{Binding Code}" Width="*"/><DataGridTextColumn Header="File A" Binding="{Binding First}" Width="110"/><DataGridTextColumn Header="File B" Binding="{Binding Second}" Width="110"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/></DataGrid.Columns></DataGrid>
      <Separator Margin="0,18,0,14"/><TextBlock x:Name="RestoreTitle" Text="Restore เฉพาะ RW" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RestoreHelp" Text="ตรวจสอบไฟล์และส่งเฉพาะรายการ RW; ต้องยืนยัน VFD หยุด และ Firmware รองรับ Safe Restore" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="RestoreLoadButton" Content="เลือก Backup..." Width="120" Height="35" Click="RestoreLoad_Click"/><Button x:Name="RestoreRunButton" Content="เริ่ม Restore" Width="112" Height="35" Margin="8,0,0,0" IsEnabled="False" Click="RestoreRun_Click"/><Button x:Name="RestoreCancelButton" Content="ยกเลิก" Width="86" Height="35" Margin="8,0,0,0" IsEnabled="False" Click="RestoreCancel_Click"/></StackPanel><ProgressBar x:Name="RestoreProgress" Height="8" Margin="0,10,0,5"/><TextBlock x:Name="RestoreStatusText" Text="ยังไม่ได้เลือกไฟล์" Foreground="{DynamicResource SecondaryText}"/></StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="SettingsTab" Header="Settings"><StackPanel Margin="22" Width="560" HorizontalAlignment="Left"><TextBlock x:Name="SettingsTitle" Text="ตั้งค่าอุปกรณ์" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SettingsHelp" Text="เปลี่ยนชื่ออุปกรณ์และพอร์ต Modbus ของ ESP32 (ไม่แก้ Parameter ใน VFD)" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,14"/><TextBlock x:Name="DeviceNameLabel" Text="ชื่ออุปกรณ์"/><TextBox x:Name="DeviceNameBox" Height="34" MaxLength="48" Margin="0,4,0,12" VerticalContentAlignment="Center"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock x:Name="SlaveLabel" Text="Slave ID"/><TextBox x:Name="SlaveBox" Text="1" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Baud"/><ComboBox x:Name="BaudBox" Height="34" Margin="0,4,0,0"><ComboBoxItem>9600</ComboBoxItem><ComboBoxItem>19200</ComboBoxItem><ComboBoxItem>38400</ComboBoxItem><ComboBoxItem>57600</ComboBoxItem><ComboBoxItem>115200</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Format"/><ComboBox x:Name="FormatBox" Height="34" Margin="0,4,0,0"><ComboBoxItem>8N2</ComboBoxItem><ComboBoxItem>8N1</ComboBoxItem><ComboBoxItem>8E1</ComboBoxItem><ComboBoxItem>8O1</ComboBoxItem></ComboBox></StackPanel></Grid><Button x:Name="SaveSettingsButton" Content="บันทึกค่า" Width="110" Height="36" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SaveSettings_Click"/><TextBlock x:Name="SettingsResult" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/></StackPanel></TabItem>
     <TabItem x:Name="DiagnosticsTab" Header="Diagnostics"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock x:Name="DiagnosticsTitle" Text="บันทึกการทำงาน" FontSize="19" FontWeight="SemiBold"/><Button x:Name="ExportLogButton" Content="ส่งออก Log..." Width="112" Height="34" DockPanel.Dock="Right" Click="ExportLog_Click"/></DockPanel><ListBox x:Name="LogList" Grid.Row="1" FontFamily="Consolas" FontSize="12"/></Grid></TabItem>
    </TabControl>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource SoftBackground}" Padding="15,7"><TextBlock x:Name="FooterText" Text="Local LAN only · No Device PIN · User-controlled discovery and connection · Windows v0.2" Foreground="{DynamicResource SecondaryText}" FontSize="11"/></Border>
 </Grid>
</ui:FluentWindow>
